# AegisSOC Backend Environment Variables
# Copy this file to .env and fill in the appropriate values

# Application Settings
PROJECT_NAME=AegisSOC
VERSION=0.1.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production-use-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 days
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Database
# SQLite (for local development)
DATABASE_URL=sqlite:///./aegis_soc.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis_soc

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AI Provider Settings
AI_PROVIDER=mock  # nim or mock
NIM_API_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your-nim-api-key-here
NIM_MODEL=nemotron-3-8b-chat
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
AI_BACKOFF_FACTOR=0.5